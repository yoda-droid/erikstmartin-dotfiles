.vscode
vim/.vim/bundle/
vim/.vim/.netrwhist
vim/.vim/.cache
vendor/bundle/ruby
.DS_Store
*.swp
*.swo
NeoBundle.lock
nvim/.config/nvim/plugged
nvim/.local
polybar/.config/polybar/fonts
tags
broot/.config/broot/launcher/
nvim/.config/mcphub
ruby/.rbenv
ruby/.bundle
tmux/.tmux/resurrect/
tmux/.tmux/plugins/

.env.local
.gitconfig-local
fish/.config/fish/conf.d/local.fish

# gh CLI — contains per-machine auth info (tokens stored in Keychain, but username/host is machine-specific)
gh/.config/gh/hosts.yml

# bin — ignore everything except explicitly tracked scripts
bin/.local/bin/*
!bin/.local/bin/project-skills
!bin/.local/bin/rename-with-icon.sh
!bin/.local/bin/tmux-cpu.sh
!bin/.local/bin/tmux-mem.sh
!bin/.local/bin/tokenscope-pricing-fix

# fish universal variables — machine-generated with absolute paths; fisher plugins tracked via fish_plugins instead
fish/.config/fish/fish_variables

# Copilot CLI — ignore everything except intentional config
copilot/.copilot/*
!copilot/.copilot/copilot-instructions.md
!copilot/.copilot/settings.json
